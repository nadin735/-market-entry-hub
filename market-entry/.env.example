# Optional: the project already ships with a default Supabase config (src/backend.js, DEFAULT_SB).
# Copy to .env (never commit .env) only to override it. Both values are PUBLIC-safe: protected by Row Level Security.
# Never put the service_role key into this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Impressum / Rechtliches (Pflichtangaben nach § 5 DDG) ----
# Werden beim Build eingebettet. Fehlen Strasse, PLZ/Ort oder E-Mail, zeigt die Seite "Rechtliches" einen Warnhinweis.
VITE_LEGAL_NAME=Nadin Okil
VITE_LEGAL_PROFESSION=
VITE_LEGAL_COUNTRY=Deutschland
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
# Datenschutz: tatsaechliche Supabase-Region und Hosting-Anbieter (muessen zur Realitaet passen)
VITE_SUPABASE_REGION=EU (Frankfurt, Deutschland)
VITE_HOSTING_PROVIDER=

# Optional: shows the connection panel at ?setup=1 (off by default, enable only for tests)
# VITE_ENABLE_SETUP=1
